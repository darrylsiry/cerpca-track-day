# Copy to .env.local and fill in. See README.md.

# Shows one-tap sample accounts on the sign-in screen and the simulated clock for admins.
# Leave unset in production.
DEMO_MODE=1

# Database. Unset = local PGlite in ./.data (zero setup). Set to a Postgres URL (Neon, Supabase…) to use a hosted database.
# DATABASE_URL=

# Public address of the app, used in links emailed to shops. Optional locally (taken from the request).
# APP_URL=https://trackday.example.org

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me

# Web Push (generated for local use; create your own pair for production with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (Resend). Without these, emails are recorded in the delivery log as "simulated".
# RESEND_API_KEY=
# EMAIL_FROM="CERPCA Track Day <trackday@yourdomain.org>"

# Text messages (Twilio). Without these, texts are recorded as "simulated".
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+19125550100

# File uploads (paper tech forms). Without this, files are stored in ./.data/uploads.
# BLOB_READ_WRITE_TOKEN=
